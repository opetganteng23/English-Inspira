# ===== Wajib di production =====
APP_URL=http://localhost:3000
# Kosongkan di dev untuk memakai MongoDB in-memory (data hilang saat server berhenti)
MONGODB_URI=
# Acak, minimal 32 karakter: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# 32 byte base64 untuk enkripsi NIK: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=
# Email yang otomatis menjadi admin saat pertama kali masuk (pisahkan dengan koma)
ADMIN_EMAILS=

# ===== Email (Gmail App Password). Kosong di dev: kode OTP dicetak ke konsol server =====
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_APP_PASSWORD=
MAIL_FROM="Edulyfe EPTA <noreply@domain-anda.com>"

# ===== AI (Claude). Kosong: Konselor & analisis memakai mode dasar berbasis aturan =====
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# ===== Penjadwal =====
# Rahasia untuk /api/cron/reminders (Vercel Cron mengirim "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=
# true = jadwalkan pengingat mingguan di dalam proses (VPS/Docker, satu instance)
ENABLE_INPROCESS_CRON=false
